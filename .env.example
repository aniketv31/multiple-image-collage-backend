# Bind 0.0.0.0 so phones on same Wi‑Fi can reach the API (see serve.py)
API_HOST=0.0.0.0
API_PORT=8000

GEMINI_API_KEY=your-gemini-api-key

GEMINI_MODEL=gemini-3.1-flash-lite

GEMINI_ANALYZE_TEMPERATURE=0.0

MIN_IMAGES=1
MAX_IMAGES=10
MAX_IMAGE_SIZE_MB=15
MAX_PREPROCESS_EDGE_PX=2048

# Detail vs cost lever (low | medium | high). ultra_high is clamped to high by the SDK.
MEDIA_RESOLUTION_COLLAGE=high
MEDIA_RESOLUTION_MULTI=high

# Gemini 3.1 Flash-Lite pricing (USD per 1M tokens)
GEMINI_INPUT_USD_PER_1M=0.25
GEMINI_OUTPUT_USD_PER_1M=1.50

# USD->INR. FX_ENABLED=false uses USD_TO_INR_FALLBACK as a fixed rate (1 USD = 100 INR).
# Set FX_ENABLED=true to fetch the live rate instead (cached + fallback).
FX_ENABLED=false
FX_API_URL=https://api.frankfurter.app/latest
FX_CACHE_TTL_SECONDS=3600
FX_TIMEOUT_SECONDS=4.0
USD_TO_INR_FALLBACK=100.0

RATE_LIMIT_PER_MINUTE=60
GEMINI_MAX_RETRIES=2
GEMINI_TIMEOUT_SECONDS=30

REVIEW_CONFIDENCE_THRESHOLD=0.65
FIELD_CONFIDENCE_THRESHOLD=0.5
