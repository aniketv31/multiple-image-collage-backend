# Bind 0.0.0.0 so phones on same Wi‑Fi can reach the API (see serve.py)
API_HOST=0.0.0.0
API_PORT=8000

GEMINI_API_KEY=your-gemini-api-key

GEMINI_MODEL=gemini-2.0-flash

GEMINI_ANALYZE_TEMPERATURE=0.0

MAX_IMAGES=10

MIN_IMAGES=2

MAX_IMAGE_SIZE_MB=7

MAX_STITCH_EDGE_PX=1600

MAX_GEMINI_EDGE_PX=2048

MAX_OUTPUT_WIDTH_PX=4096

MAX_GEMINI_COMPOSITE_BYTES=6500000

MAX_COMPOSITE_WIDTH_PX=4096

ANALYSIS_MIN_CELL_PX=640

ANALYSIS_MAX_CELL_PX=1280

TAG_ZOOM_SCALE=2.5

COLLAGE_TAG_SLOT_SCALE=1.35

COLLAGE_HERO_SCALE=1.2

TAG_ZOOM_ROW_MIN_PX=400

TAG_ZOOM_PANEL_MIN_PX=1200

TAG_ZOOM_UPSCALE_MAX=4.0

TAG_ZOOM_ROW_HEIGHT_RATIO=0.45

TAG_ZOOM_CLAHE_CLIP=3.0

GEMINI_TAG_MAX_EDGE_PX=2048

PANORAMA_DEFAULT_LAYOUT=collage

PANORAMA_TAG_THUMB_MAX_EDGE=480

RATE_LIMIT_PER_MINUTE=60

GEMINI_MAX_RETRIES=2

GEMINI_TIMEOUT_SECONDS=30

REVIEW_CONFIDENCE_THRESHOLD=0.65

FIELD_CONFIDENCE_THRESHOLD=0.5


